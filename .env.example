# Server-side (Vercel project env vars; never exposed to the browser)
# GEMINI_API_KEY: Google Gemini key used for recipe parsing, substitutions and chat.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Client-side
# VITE_FIREBASE_AUTH_DOMAIN: set to the app's own domain (heirloom.tonykim.io) so Google
# sign-in runs same-origin through the /__/auth proxy in vercel.json. Required for iOS
# Safari and the installed PWA. Leave unset for local development.
# VITE_FIREBASE_AUTH_DOMAIN="heirloom.tonykim.io"

# VITE_SENTRY_DSN: optional Sentry DSN for error telemetry.
# VITE_SENTRY_DSN=""
